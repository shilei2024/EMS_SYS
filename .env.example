# ===================================
# 电子元器件代理商增值系统 - 环境变量配置示例
# ===================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 修改下面的默认值为您的实际配置
# 3. 确保 .env 文件未被提交到版本控制（已加入 .gitignore）
#
# 生成安全密钥的方法：
# - Linux/Mac: openssl rand -base64 32
# - Windows (PowerShell): [Convert]::ToBase64String((New-Object Security.Cryptography.RNGCryptoServiceProvider).GetBytes(32))
# - Python: python -c "import secrets; print(secrets.token_urlsafe(32))"

# ===================================
# 数据库配置 (PostgreSQL)
# ===================================
POSTGRES_USER=postgres
POSTGRES_DB=component_agent
# 【重要】必须修改为强密码（至少 16 位，包含大小写字母、数字、特殊字符）
POSTGRES_PASSWORD=your-super-secure-postgres-password-here

# ===================================
# Neo4j 图数据库配置
# ===================================
# 格式：neo4j/password
# 【重要】必须修改
NEO4J_AUTH=neo4j/your-super-secure-neo4j-password-here
NEO4J_PASSWORD=your-super-secure-neo4j-password-here

# ===================================
# Redis 配置
# ===================================
# 【重要】必须修改为强密码
REDIS_PASSWORD=your-super-secure-redis-password-here

# ===================================
# MinIO 对象存储配置
# ===================================
# 【重要】必须修改
MINIO_ROOT_USER=your-minio-admin-user
MINIO_ROOT_PASSWORD=your-super-secure-minio-password-here

# ===================================
# JWT 认证配置
# ===================================
# 【关键安全配置】必须使用至少 32 个字符的随机字符串
# 生成命令：openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-random-string

# ===================================
# AI 模型 API 密钥（可选）
# ===================================
# 根据使用的模型提供商设置对应的密钥
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ===================================
# 加密密钥配置（财务服务）
# ===================================
# 【关键安全配置】必须正好 32 个字符（AES-256 要求）
# 生成命令：openssl rand -base64 32 | cut -c1-32
ENCRYPTION_AES_KEY=exactly-32-characters-aes-key-here!

# ===================================
# 服务配置
# ===================================
# 运行环境：development, staging, production
ENVIRONMENT=development

# ===================================
# CORS 配置（生产环境必须修改）
# ===================================
# 生产环境应该设置为实际的域名，例如：
# CORS_ALLOW_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080
