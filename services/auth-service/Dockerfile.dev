# 认证服务开发环境Dockerfile
FROM golang:1.21-alpine

WORKDIR /go/src/app

# 安装系统依赖
RUN apk add --no-cache \
    git \
    curl \
    build-base \
    postgresql-client

# 复制go模块文件
COPY go.mod go.sum ./

# 下载依赖
RUN go mod download

# 复制源代码
COPY . .

# 构建应用
RUN go build -o /go/bin/app ./cmd

# 创建非root用户
RUN adduser -D -u 1000 appuser
USER appuser

# 暴露端口
EXPOSE 8001

# 启动命令
CMD ["/go/bin/app"]